# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project Settings > Environment Variables.

# Postgres connection string.
#   Local:    postgres://postgres:postgres@127.0.0.1:5433/postgres   (from `npm run db:local`)
#   Supabase: the "Transaction pooler" string (port 6543) from the project's Connect panel
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Cloudflare Turnstile (CAPTCHA). Leave both blank locally to turn the CAPTCHA off.
# On the live site, submissions are refused if the secret is missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Any long random string. Used to scramble IP addresses for rate limiting.
IP_HASH_SALT=

# The public address of the site, used for link previews. e.g. https://misattributioncrisis.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
